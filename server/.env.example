# Скопируйте этот файл в .env и заполните. Файл .env не публикуйте и не отправляйте в GitHub.
PORT=8787
HOST=127.0.0.1
# Куда сохранять заявки на сервере (папка создаётся сама, доступ только у владельца)
DATA_DIR=/var/lib/badcom-zayavki
# Через сколько дней удалять заявки (в Согласии указано 30)
RETENTION_DAYS=30

# Почтовый сервер для отправки заявок на info@badcom.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_MODE=tls
SMTP_USER=info@badcom.ru
SMTP_PASS=пароль_приложения
MAIL_FROM=info@badcom.ru
MAIL_TO=info@badcom.ru

# Telegram: токен бота и номер чата. Пустые значения отключают уведомления.
TG_BOT_TOKEN=
TG_CHAT_ID=
# false — в Telegram уходит только номер заявки и район. true — ещё имя, телефон и адрес
# (это передача персональных данных за границу, см. README).
TG_FULL=false
